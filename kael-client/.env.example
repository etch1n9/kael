# Optional initial backend origin. Leave blank to use the current hostname on port 1507.
# Examples: http://192.168.1.20:1507 or https://kael.instansi.id
# The browser adds /api internally. The login page can override the server explicitly.
# VITE_ values are public and embedded in the browser build. Never put secrets here.
VITE_API_BASE_URL=

# Used only by the Vite development/preview proxy, not by the production build.
KAEL_API_PROXY_TARGET=http://127.0.0.1:1507
