# Salin menjadi .env di direktori kael-server. Variabel shell mengalahkan file ini.
# Semua path relatif dihitung dari direktori kael-server, termasuk kata sandi setup.
KAEL_HOST=127.0.0.1
PORT=1507
KAEL_DATA_FILE=storage/kael.sqlite

# Backend mandiri hanya melayani API jika kosong. npm start dari akar menyertakan web.
# KAEL_WEB_ROOT=../kael-client/dist

# Origin frontend terpisah yang diizinkan mengakses API; koma untuk beberapa origin.
# Tidak diperlukan jika browser memakai origin yang sama atau proxy /api dari Vite.
# KAEL_CLIENT_ORIGINS=https://client.instansi.id,http://192.168.1.20:5173

# GET /api/health hanya memberi identitas protokol KAEL, tanpa data fasilitas.
# Pembacaan lintas origin mengikuti KAEL_CLIENT_ORIGINS yang sama dengan API.

# Tujuan API tambahan yang diizinkan CSP bagi web yang dilayani backend ini.
# Isi hanya jika pengaturan endpoint di browser mengarah ke server berbeda.
# KAEL_API_ORIGINS=https://api.instansi.id

# Hanya diperlukan saat bootstrap superuser via npm run setup.
# Fasilitas, role bisnis, serta akun berikutnya dibuat manual lewat panel superuser.
# KAEL_ADMIN_USERNAME=superuser
# KAEL_ADMIN_FULL_NAME=Administrator
# Kata sandi minimal 8 karakter; boleh diberikan lewat environment saat setup.
# KAEL_ADMIN_PASSWORD=
# Alternatif: baca kata sandi dari file dengan akses terbatas.
# KAEL_ADMIN_PASSWORD_FILE=storage/admin-password
# KAEL_NODE_NAME=KAEL
