{
  "name": "kael",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "kael-client"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w kael-client",
    "dev:server": "sh scripts/server.sh dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build -w kael-client",
    "build:server": "sh scripts/server.sh build",
    "preview": "npm run preview -w kael-client",
    "start": "sh scripts/server.sh web",
    "start:server": "sh scripts/server.sh serve",
    "setup": "sh scripts/server.sh setup",
    "check": "npm run check -w kael-client && sh scripts/server.sh check"
  }
}
